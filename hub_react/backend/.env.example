# --- Banco de dados (o mesmo MySQL do sistema Flask) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=usuario
DB_PASSWORD=senha
DB_NAME=hub

# --- Sessão ---
# Gere um valor aleatório longo, ex.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio
SESSION_HOURS=12
# true quando o site roda em HTTPS
COOKIE_SECURE=false

# --- Painel administrativo ---
# Valores de usuarios.nivel_acesso que podem acessar /admin (separados por vírgula)
ADMIN_LEVELS=admin
# Valores de usuarios.nivel_acesso que podem acessar o painel do RH (/rh)
RH_LEVELS=rh

# --- Clima (HG Brasil) ---
HG_WEATHER_API_KEY=
# IP público usado quando o acesso vem da rede interna
WEATHER_FALLBACK_IP=200.233.220.149

# --- Servidor ---
PORT=3001
# Proxies confiáveis na frente da API (ex.: 1 com Nginx/Cloudflare). Padrão: loopback
TRUST_PROXY=loopback

# Pasta dos arquivos enviados pelo painel (banners). Padrão: backend/uploads
# UPLOADS_DIR=uploads

# --- Factorial (colaboradores pelo CPF) ---
# Chave criada por um administrador no Factorial: Configuração > API > Criar chave de API
FACTORIAL_API_KEY=
# FACTORIAL_API_URL=https://api.factorialhr.com
# Versão da API (trimestral, cada uma vale 1 ano — atualize quando o Factorial avisar)
FACTORIAL_API_VERSION=2026-10-01
# De quantas em quantas horas sincroniza sozinho (0 = só pelo botão no painel do RH)
FACTORIAL_SYNC_HORAS=6
# Trava: a sincronização automática não bloqueia mais que isso de uma vez (o RH confere e aplica)
FACTORIAL_MAX_BLOQUEIOS=20
# Campo do funcionário com o CPF. Vazio = descobre sozinho (identifier, social_security_number...)
# FACTORIAL_CAMPO_CPF=identifier
